{
  "_comment": [
    "Candidate locators for each step, tried in order across every frame on the page.",
    "Written from the portal's public JavaScript bundle (which is where the mobile_email,",
    "otp_modal and order-confirmation names come from) rather than a signed-in session,",
    "so the first run WILL need corrections. Run `node src/index.js calibrate`, find the",
    "real selectors, and put overrides in selectors.local.json — same keys, replacing the",
    "list outright. Keep personal fixes there so updates to this file do not clobber them.",
    "",
    "The portal is a React build with minified class names, so prefer text, placeholder",
    "and label selectors: those survive a redeploy, '.lsss3' does not."
  ],

  "loggedInMarker": [
    "role=link|Logout",
    "role=button|Logout",
    "text=Sign out",
    "css=[data-testid='account-menu']",
    "css=.user-name, .account-name"
  ],
  "loginLink": [
    "role=link|Login",
    "role=button|Login",
    "role=link|Sign in",
    "text=Login"
  ],
  "loginIdentifier": [
    "placeholder=Mobile Number or Email",
    "placeholder=Mobile Number",
    "placeholder=Mobile",
    "label=Mobile Number or Email",
    "label=Mobile Number",
    "css=input[name='mobile_email'], input[name='mobile'], input[name='mobile_number']",
    "css=input[name='username'], input[name='userid'], input#username",
    "css=input[type='tel']"
  ],
  "password": [
    "label=Password",
    "placeholder=Password",
    "css=input[type='password']"
  ],
  "loginSubmit": [
    "role=button|Log in",
    "role=button|Login",
    "role=button|Sign in",
    "role=button|Continue",
    "role=button|Get OTP",
    "role=button|Send OTP",
    "css=button[type='submit']"
  ],
  "loginOtp": [
    "label=OTP",
    "placeholder=OTP",
