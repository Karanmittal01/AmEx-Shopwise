    "css=input[name='otpname'], input[name*='otp' i]",
    "css=input[autocomplete='one-time-code']"
  ],
  "loginOtpSubmit": [
    "role=button|Verify",
    "role=button|Submit",
    "role=button|Continue",
    "css=button[type='submit']"
  ],

  "searchInput": [
    "role=searchbox",
    "placeholder=Search",
    "css=input[type='search'], input[name='q'], input[name='search']"
  ],
  "searchSubmit": [
    "role=button|Search",
    "css=button[type='submit'][aria-label*='search' i]"
  ],
  "productLink": [
    "role=link|Amazon Pay",
    "text=Amazon Pay Gift Card",
    "text=Amazon Pay",
    "css=a[href*='amazon-pay' i]"
  ],

  "denomination": [
