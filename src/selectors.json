  "amountInput": [
    "label=Amount",
    "placeholder=Amount",
    "placeholder=Enter amount",
    "css=input[name*='amount' i], input#amount"
  ],
  "quantityInput": [
    "label=Quantity",
    "css=input[name*='quantity' i], input#quantity"
  ],

  "addToCart": [
    "role=button|Add to cart",
    "role=button|Add to bag",
    "text=Add to cart",
    "css=button[data-action='add-to-cart']"
  ],
  "goToCart": [
