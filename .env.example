# Copy to .env and adjust. No secrets go here — card details live in the
# encrypted vault (`node src/index.js setup`).

# Portal entry point.
SHOPWISE_URL=https://shopwise.giftstacc.com/

# What to buy. AMOUNT is the gift card's face value, before fees.
SEARCH_TERM=Amazon Pay
AMOUNT=1000
CURRENCY_SYMBOL=₹

# The portal adds a convenience fee plus GST on top of the face value, so a
# ₹1,000 card is charged at about ₹1,017.70. The flow reads the real total off
# the checkout page; these only decide the ceiling it must fall under.
FEE_PERCENT=1.5
GST_PERCENT=18
FEE_TOLERANCE=2

# Absolute ceiling on what may be paid. Leave unset to derive it from the fee
# percentages above — safer, because it moves with AMOUNT.
# MAX_AMOUNT=

# Six monthly purchases, then the schedule retires itself.
TOTAL_RUNS=6

# ---------------------------------------------------------------------------
# Worker mode — driven from the Tools page in Splitwise Killer
# ---------------------------------------------------------------------------

# Where the web app lives, and the shared secret it expects. Must match
# SHOPWISE_WORKER_TOKEN in the web app's environment. Generate with:
#   openssl rand -hex 32
APP_URL=https://split.karanmittal.com
WORKER_TOKEN=

# How often to ask the app for work, and how long to wait for you to send an OTP.
POLL_INTERVAL_MS=15000
OTP_POLL_MS=2000
OTP_TIMEOUT_MS=360000

# ---------------------------------------------------------------------------
# Standalone mode — running `run` from a terminal instead
# ---------------------------------------------------------------------------

# OTP relay: open http://<this-machine>:8787/ to send the code.
OTP_PORT=8787

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------

# Set HEADLESS=false for the first run so you can watch it.
HEADLESS=true
SLOW_MO_MS=120
NAV_TIMEOUT_MS=60000
STEP_TIMEOUT_MS=30000

# Path to a Chromium binary. Leave unset to use the one Playwright downloads.
# On Android this is Debian's chromium inside a Termux proot — see docs/android.md,
# which sets this to `which chromium` for you.
# CHROMIUM_PATH=

# Chromium can't run its sandbox as root (e.g. inside a proot). This is turned on
# automatically when running as root; set it explicitly only to override.
# NO_SANDBOX=true

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------

# Passphrase for unattended runs. On a machine you own, prefer ./vault.key
# (chmod 600) over this — environment variables leak into process listings.
# SHOPWISE_VAULT_PASS=
# SHOPWISE_VAULT_KEYFILE=/home/karan/.shopwise.key

# On a container host with no persistent disk (Fly, Railway, Render), hand the
# encrypted vault over as a secret instead of a file:
#   base64 -w0 vault.enc
# Still ciphertext — SHOPWISE_VAULT_PASS is needed as well to open it.
# SHOPWISE_VAULT_B64=
