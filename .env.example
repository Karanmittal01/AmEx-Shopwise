# Copy to .env and adjust. No secrets go here — card details live in the
# encrypted vault (`node src/index.js setup`).

# Portal entry point. Change this if the real Shopwise URL differs.
SHOPWISE_URL=https://www.amexshopwise.com/

# What to buy
SEARCH_TERM=Amazon Pay
AMOUNT=1000
CURRENCY_SYMBOL=₹

# Hard ceiling. The flow reads the real order total off the page and aborts if it
# is anything other than AMOUNT, or above this. Keep it tight.
MAX_AMOUNT=1000

# Six monthly purchases, then the schedule retires itself.
TOTAL_RUNS=6

# OTP relay: open http://<this-machine>:8787/ on your phone to send the code.
OTP_PORT=8787
OTP_TIMEOUT_MS=360000

# Browser. Set HEADLESS=false for the first run so you can watch it.
HEADLESS=true
SLOW_MO_MS=120
NAV_TIMEOUT_MS=60000
STEP_TIMEOUT_MS=30000

# Vault passphrase for unattended runs. Prefer ./vault.key (chmod 600) over this,
# since environment variables leak into process listings.
# SHOPWISE_VAULT_PASS=
# SHOPWISE_VAULT_KEYFILE=/data/data/com.termux/files/home/.shopwise.key
